# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. These values are for LOCAL DEVELOPMENT ONLY.
# In AWS, the same variables are injected from Secrets Manager / Parameter Store.

# --- PostgreSQL (used by docker-compose and by the backend) ---
ESM_DB_NAME=esm
ESM_DB_USERNAME=esm
ESM_DB_PASSWORD=local-dev-only-change-me
ESM_DB_PORT=5432
ESM_DB_URL=jdbc:postgresql://localhost:5432/esm

# --- Authentication ---
# DEV-ONLY value so the project starts out of the box. Generate your own with:
#   openssl rand -base64 32
# Production reads ESM_JWT_SECRET from AWS Secrets Manager.
ESM_JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1jaGFuZ2UtbWUtMzJieXRlcyE=

# First admin, created on startup only if no active admin exists. LOCAL DEVELOPMENT ONLY.
ESM_BOOTSTRAP_ADMIN_EMAIL=admin@esm.local
ESM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-LocalAdmin-2026
ESM_BOOTSTRAP_ADMIN_NAME=Local Admin

# --- Full Docker stack (docker compose up --build) ---
# Web app port on this machine: http://localhost:3000
ESM_WEB_PORT=3000
# Password for every *@demo.local demo account. LOCAL DEMOS ONLY; at least 12 characters.
ESM_DEMO_PASSWORD=Demo-Password-2026
